# Absolute path to command-code/dist/index.mjs from the authenticated global installation.
JARVIS_COMMAND_CODE_ENTRY=C:\\path\\to\\node_modules\\command-code\\dist\\index.mjs

# Optional. Omit to use Command Code's configured default model.
# JARVIS_COMMAND_CODE_MODEL=provider/model-id

JARVIS_AGENT_TIMEOUT_MS=60000
JARVIS_AGENT_MAX_TURNS=2

# Absolute path to your Obsidian vault directory (server-side only, never exposed to browser)
# OBSIDIAN_VAULT_PATH=C:\\path\\to\\your\\vault

# Optional. Path to Google Workspace CLI executable (server-side only, never exposed to browser)
# JARVIS_GWS_EXECUTABLE=C:\\path\\to\\gws.cmd

# Phase 7.5: Reasoning Provider Selection (command-code | ollama, defaults to command-code)
# JARVIS_PROVIDER=command-code

# Phase 7.5: Local Ollama Configuration (defaults to http://localhost:11434)
# JARVIS_OLLAMA_BASE_URL=http://localhost:11434
# Optional. Model name installed locally in Ollama (e.g. llama3.2, qwen2.5:7b).
# If omitted, JARVIS will auto-detect the first installed local model.
# JARVIS_OLLAMA_MODEL=llama3.2

# Phase 8: Local Speech-to-Text (Whisper / whisper.cpp)
# Defaults to http://localhost:8080 (local whisper.cpp server started via .jarvis/voice/runtime/start-voice.ps1)
# JARVIS_WHISPER_BASE_URL=http://localhost:8080
# JARVIS_WHISPER_URL=http://localhost:8080
# Project-local model path (intentionally kept outside git):
# JARVIS_WHISPER_MODEL_PATH=.jarvis/voice/models/ggml-base.en.bin
# JARVIS_WHISPER_LANGUAGE=en
# JARVIS_WHISPER_THREADS=4
# Optional CLI transport executable (if using CLI instead of HTTP server):
# JARVIS_WHISPER_EXECUTABLE=.jarvis/voice/whisper/Release/whisper-cli.exe

# Phase 8: Local Text-to-Speech (Kokoro TTS)
# Defaults to http://localhost:8880 (local Kokoro FastAPI server started via .jarvis/voice/runtime/start-voice.ps1)
# JARVIS_KOKORO_BASE_URL=http://localhost:8880
# JARVIS_KOKORO_MODEL=kokoro
# JARVIS_KOKORO_VOICE=am_adam
# JARVIS_KOKORO_SPEED=1.0

# Hermes Agent API Server
# HERMES_API_URL=http://127.0.0.1:8642
# HERMES_API_KEY=your-hermes-api-key-32ch-min
# HERMES_TIMEOUT_MS=60000
